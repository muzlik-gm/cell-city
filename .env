# ─── Cell City Environment Configuration ─────────────────────
# 
# PRODUCTION (Vercel): Uses Turso/libSQL remote database
# DEVELOPMENT: Falls back to local SQLite if Turso not configured
# ─────────────────────────────────────────────────────────────

# ─── Production Database (Turso/libSQL) ──────────────────────
# REQUIRED for Vercel deployment - Set these in Vercel Dashboard:
TURSO_DATABASE_URL="libsql://cell-city-muzlik.aws-ap-south-1.turso.io"
TURSO_AUTH_TOKEN=""

# ─── Local Development (SQLite) ──────────────────────────────
# Used only as fallback when TURSO vars are not set
DATABASE_URL="file:./prisma/dev.db"

# ─── AI / Google Gemini API ─────────────────────────────────
GOOGLE_API_KEY="your-google-api-key-here"

# ─── Application Settings ───────────────────────────────────
NEXTAUTH_SECRET="cellcity-production-secret-2024"
NEXTAUTH_URL="https://cell-city.vercel.app"
NODE_ENV="production"
SHOW_DB_ERRORS="true"
